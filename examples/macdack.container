[Unit]
Description=macdack static DHCPv4 server container

[Container]
ContainerName=macdack
Image=ghcr.io/psvmcc/macdack:stable
Pull=newer
AutoUpdate=registry
Network=host
Volume=/etc/macdack:/etc/macdack:ro
Volume=/var/lib/macdack:/var/lib/macdack:U
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE
ReloadSignal=HUP

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
