# Native ARM64 compiler produces an AMD64 binary without emulating rustc.
FROM --platform=linux/arm64 docker.io/library/rust:1.98.0-trixie AS builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu libc6-dev-amd64-cross && rm -rf /var/lib/apt/lists/*
COPY rust-toolchain.toml /tmp/rust-toolchain.toml
RUN rustup toolchain install 1.98.1 --profile minimal --component clippy --component rustfmt \
    && rustup target add --toolchain 1.98.1 x86_64-unknown-linux-gnu
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
ENV CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
RUN cargo build --locked --release --target x86_64-unknown-linux-gnu --bin macmapd

FROM --platform=linux/amd64 gcr.io/distroless/cc-debian13:nonroot
COPY --from=builder /build/target/x86_64-unknown-linux-gnu/release/macmapd /usr/local/bin/macmapd
EXPOSE 67/udp 8080/tcp
ENTRYPOINT ["/usr/local/bin/macmapd"]
CMD ["--config", "/etc/macmapd/config.toml"]
